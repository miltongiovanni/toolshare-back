{% extends 'base_auth.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block javascripts %}

    {% block importmap %}{{ importmap('auth') }}{% endblock %}

{% endblock %}
{% block content %}
    <div class="card tab2-card card-login">
        <div class="card-body">
            <form name="change_password_form" action="{{ path('reset_password_update') }}" class="auth-form" method="post">
                <h1 class="h3 mb-3 font-weight-normal">Reset your password{#{{ 'auth.sign_in'|trans }}#}</h1>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="change_password_form_plainPassword_first" placeholder="New password" name="new_password" required autofocus autocomplete="new-password">
                    <label for="change_password_form_plainPassword_first" >New password</label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="change_password_form_plainPassword_second" placeholder="Repeat Password" name="confirm_password" required autocomplete="new-password">
                    <label for="change_password_form_plainPassword_second" >Repeat Password</label>
                </div>

                <input type="hidden" id="change_password_form__token" name="change_password_form[_token]" data-controller="csrf-protection" value="csrf-token">
                <div class="d-flex justify-content-between align-items-center my-3">
                    <button class="btn btn-lg btn-primary" type="submit">
                        Reset password{#{{ 'auth.login'|trans }}#}
                    </button>
                    <div class="mt-3 mb-3">
                        <a href="{{ path('reset_password', {_locale: 'en'}) }}" class="btn btn-default forgot-pass">EN</a> |
                        <a href="{{ path('reset_password', {_locale: 'fr'}) }}" class="btn btn-default forgot-pass">FR</a> |
                        <a href="{{ path('reset_password', {_locale: 'es'}) }}" class="btn btn-default forgot-pass">ES</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
