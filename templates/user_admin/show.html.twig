{% extends 'base.html.twig' %}

{% block title %}UserAdmin{% endblock %}

{% block body %}
    <h1>UserAdmin</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user_admin.id }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user_admin.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user_admin.roles ? user_admin.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user_admin.password }}</td>
            </tr>
            <tr>
                <th>First_name</th>
                <td>{{ user_admin.firstName }}</td>
            </tr>
            <tr>
                <th>Last_name</th>
                <td>{{ user_admin.lastName }}</td>
            </tr>
            <tr>
                <th>Passcode</th>
                <td>{{ user_admin.passcode }}</td>
            </tr>
            <tr>
                <th>Is_verified</th>
                <td>{{ user_admin.isVerified ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ user_admin.createdAt ? user_admin.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ user_admin.slug }}</td>
            </tr>
            <tr>
                <th>Is_active</th>
                <td>{{ user_admin.isActive ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_admin_index') }}">back to list</a>

    <a href="{{ path('app_user_admin_edit', {'id': user_admin.id}) }}">edit</a>

    {{ include('user_admin/_delete_form.html.twig') }}
{% endblock %}
