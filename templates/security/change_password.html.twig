{% extends 'base_auth.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block javascripts %}

    {% block importmap %}{{ importmap('auth') }}{% endblock %}

{% endblock %}
{% block content %}
    <div class="card tab2-card card-login">
        <div class="card-body">
            {# read and display just one flash message type #}
            {% for message in app.flashes('error') %}
                <div class="flash-notice d-flex align-items-center text-danger mb-2">
                    <i class="alert-color me-2" data-feather="alert-circle"></i>{{ message }}
                </div>
            {% endfor %}
            <form id="change_password_form" action="{{ path('update_password') }}" class="auth-form needs-validation" method="post"  novalidate autocomplete="off">
                <h1 class="h3 mb-4 font-weight-normal">{{ 'auth.password.change'|trans }}</h1>
                <div class="input-group mb-3">
                    <div class="form-floating ">
                        <input type="password" class="form-control validate-password" id="new_password" placeholder="New password" name="new_password" required>
                        <label for="new_password">{{ 'auth.password.new'|trans }}</label>
                    </div>
                    <span toggle="#new_password" class="fa fa-fw fa-eye input-group-text toggle-password"></span>

                </div>
                <div id="message">
                    <h4>{{ 'auth.password.validation'|trans }}</h4>
                    <p id="letter" class="invalid">{{ 'auth.password.lowercase'|trans |raw }}</p>
                    <p id="capital" class="invalid">{{ 'auth.password.uppercase'|trans |raw }}</p>
                    <p id="number" class="invalid">{{ 'auth.password.number'|trans |raw }}</p>
                    <p id="special" class="invalid">{{ 'auth.password.special'|trans |raw }}</p>
                    <p id="length" class="invalid">{{ 'auth.password.length'|trans |raw }}</p>
                </div>
                <div class="input-group">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="confirm_password" placeholder="Repeat Password" name="confirm_password" required autocomplete="off">
                        <label for="confirm_password">{{ 'auth.password.confirm'|trans }}</label>
                    </div>
                    <span toggle="#confirm_password" class="fa fa-fw fa-eye input-group-text toggle-password"></span>
                </div>
                <label class="text-danger d-none" id="password_no_match"> {{ 'auth.password.no_match'|trans }} </label>
                <div class="input-group my-3">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="old_password" placeholder="Repeat Password" name="old_password" required
                               autocomplete="off">
                        <label for="old_password">{{ 'auth.password.old'|trans }}</label>
                    </div>
                    <span toggle="#old_password" class="fa fa-fw fa-eye input-group-text toggle-password"></span>
                </div>

                <input type="hidden" id="change_password_form__token" name="change_password_form[_token]" data-controller="csrf-protection" value="csrf-token">
                <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
                    <button class="btn btn-lg mt-0 btn-primary w-75" id="submit_change_password_form" disabled type="submit">
                        {{ 'auth.password.reset'|trans }}
                    </button>
                    <div class="mt-3 w-25 ps-3 mb-3">
                        <a href="{{ path('change_password', {_locale: 'en'}) }}" class="btn btn-default forgot-pass">EN</a> |
                        <a href="{{ path('change_password', {_locale: 'fr'}) }}" class="btn btn-default forgot-pass">FR</a> |
                        <a href="{{ path('change_password', {_locale: 'es'}) }}" class="btn btn-default forgot-pass">ES</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
