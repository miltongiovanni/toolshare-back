{% extends 'base_auth.html.twig' %}

{% block title %}Log in!{% endblock %}
{% block javascripts %}

    {% block importmap %}{{ importmap('auth') }}{% endblock %}

{% endblock %}

{% block content %}

    <div class="card tab2-card card-login">
        <div class="card-body">
            <form method="post" id="login_form" class="auth-form needs-validation" novalidate>
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-3">
                        You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('logout') }}">Logout</a>
                    </div>
                {% endif %}

                <h1 class="h3 mb-3 font-weight-normal">{{ 'auth.sign_in'|trans }}</h1>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" value="{{ last_username }}" id="username" name="_username" autocomplete="email" required autofocus placeholder="name@example.com">
                    <label for="username">{{ 'auth.email'|trans }}</label>
                </div>
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input type="password" class="form-control" id="password" name="_password" placeholder="Password" autocomplete="current-password" required>
                        <label for="password">{{ 'auth.password'|trans }}</label>
                    </div>
                    <span toggle="#password" class="fa fa-fw fa-eye input-group-text toggle-password"></span>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                {# Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html #}
                <div class="d-flex justify-content-between align-items-center my-3">
                    <div class="checkbox">
                        <input type="checkbox" name="_remember_me" id="_remember_me">
                        <label for="_remember_me">{{ 'auth.remember_me'|trans }}</label>
                    </div>
                    <a href="javascript:void(0)"
                       class="btn btn-default forgot-pass">{{ 'auth.forgot_password'|trans }}</a>
                </div>
                <div class="d-flex justify-content-between align-items-center my-3">
                    <button class="btn btn-lg btn-primary" id="" type="submit">
                        {{ 'auth.login'|trans }}
                    </button>
                    <div class="mt-3 mb-3">
                        <a href="{{ path('login', {_locale: 'en'}) }}" class="btn btn-default forgot-pass">EN</a> |
                        <a href="{{ path('login', {_locale: 'fr'}) }}" class="btn btn-default forgot-pass">FR</a> |
                        <a href="{{ path('login', {_locale: 'es'}) }}" class="btn btn-default forgot-pass">ES</a>
                    </div>
                </div>
                <div class="form-footer">
                    {# <span>Or Login up with social platforms</span>
                            <ul class="social">
                                <li><a class="ti-facebook" href=""></a></li>
                                <li><a class="ti-twitter" href=""></a></li>
                                <li><a class="ti-instagram" href=""></a></li>
                                <li><a class="ti-pinterest" href=""></a></li>
                            </ul> #}
                </div>
            </form>
        </div>
    </div>



{% endblock %}
