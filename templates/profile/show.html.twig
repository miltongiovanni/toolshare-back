{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <h1>Profile</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ profile.id }}</td>
            </tr>
            <tr>
                <th>Code</th>
                <td>{{ profile.code }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ profile.createdAt ? profile.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ profile.slug }}</td>
            </tr>
            <tr>
                <th>Description_en</th>
                <td>{{ profile.descriptionEn }}</td>
            </tr>
            <tr>
                <th>Description_fr</th>
                <td>{{ profile.descriptionFr }}</td>
            </tr>
            <tr>
                <th>Description_es</th>
                <td>{{ profile.descriptionEs }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_profile_index') }}">back to list</a>

    <a href="{{ path('app_profile_edit', {'id': profile.id}) }}">edit</a>

    {{ include('profile/_delete_form.html.twig') }}
{% endblock %}
