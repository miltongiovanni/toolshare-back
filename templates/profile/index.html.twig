{% extends 'base.html.twig' %}

{% block title %}Profile index{% endblock %}
{% block stylesheets %}
    {{ parent() }}
{% endblock %}
{% block javascripts %}
    {% block importmap %}{{ importmap(['app', 'sidebar-menu' ]) }}{% endblock %}
{% endblock %}

{% block content %}

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>{{ 'table.role'|trans }}</th>
                <th>Slug</th>
                <th>{{ 'table.description'|trans }}</th>
                <th>{{ 'table.createdAt'|trans }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for profile in profiles %}
            <tr>
                <td>{{ profile.id }}</td>
                <td>{{ profile.code }}</td>
                <td>{{ profile.slug }}</td>
                <td>{{ profile.description }}</td>
                <td>{{ profile.created_at ? profile.created_at|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Action
                        </button>
                        <ul class="dropdown-menu">
                            {#<a class="dropdown-item" href="{{ path('profile_show', {'id': profile.id}) }}">show</a>#}
                            <a class="dropdown-item" href="{{ path('profile_edit', {'id': profile.id}) }}">edit</a>
                        </ul>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('profile_new') }}">Create new</a>
{% endblock %}
